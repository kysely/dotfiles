font-size=13
adjust-cell-height = 30%
theme = light:GitHub Light Default,dark:Catppuccin Frappe

# Disable font zoom shortcuts (conflicts with Cmd+1 on Czech layout)
keybind = cmd++=unbind
keybind = cmd+==unbind
keybind = cmd+-=unbind
keybind = cmd+0=unbind


# Pass Cmd+J as C-j for tmux ergonomics
keybind = cmd+j=text:\x0a

