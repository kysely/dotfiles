# Managed by dotfiles. Host/app-specific zsh setup can stay in ~/.zshrc.

export EDITOR="nvim"
export VISUAL="$EDITOR"

alias ls='eza'
alias tree='eza --tree'
alias cd='z'
alias g='git'
alias ga='git add'
alias gd='git diff'
alias gp='git push'
alias gs='git status'
alias hd='hunk diff'
alias lg='lazygit'
alias t='tmux'
alias ta='tmux a'
alias tls='tmux ls'

gc() {
  if [[ $# -eq 0 ]]; then
    echo 'usage: gc <message>' >&2
    return 1
  fi

  git commit -v -m "$*"
}

tt() {
  if [[ $# -eq 0 ]]; then
    echo 'usage: tt <session-name>' >&2
    return 1
  fi

  tmux new-session -s "$1" -n "$1"
}

# Add common user-local bin directories first when they exist.
[[ -d "$HOME/.local/bin" ]] && export PATH="$HOME/.local/bin:$PATH"
[[ -d "$HOME/bin" ]] && export PATH="$HOME/bin:$PATH"

# Tool initialization.
export NVM_DIR="$HOME/.nvm"
[[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh"
[[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"

command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"
