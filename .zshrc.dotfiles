# Managed by dotfiles. Host/app-specific zsh setup can stay in ~/.zshrc.

export XDG_CONFIG_HOME="$HOME/.config"
export EDITOR="nvim"
export VISUAL="$EDITOR"

# Ghostty sets TERM=xterm-ghostty, which fresh remote hosts often don't have
# in their terminfo database. That breaks zsh/readline key handling over SSH
# (backspace/delete/arrows) and makes tools like tput fail. Fall back to the
# widely available xterm-256color when the current TERM is unknown.
if [[ -n "${TERM:-}" ]] && ! infocmp "$TERM" >/dev/null 2>&1; then
  export TERM="xterm-256color"
fi

# Make both common backspace encodings work in zsh.
bindkey '^?' backward-delete-char
bindkey '^H' backward-delete-char

alias ls='eza'
alias tree='eza --tree'
alias cd='z'
alias g='git'
alias ga='git add'
alias gd='git diff'
alias gp='git push'
alias gs='git status'
alias hd='hunk diff'
alias lg='lazygit'
alias mosh='mosh --no-init'
alias t='tmux'
alias ta='tmux a'
alias tat='tmux attach -t "$(tmux list-sessions -F "#{session_name}" 2>/dev/null | fzf)"'
alias taa='tat'
alias tkill='tmux kill-session'
alias tls='tmux ls'
alias v='vim'
alias n='nvim'
alias reload='source ~/.zshrc'
alias upgrade='_dotfiles_upgrade'
alias wop='whatsonport'

# Debian/Ubuntu install the bat package as `batcat`.
if ! command -v bat >/dev/null 2>&1 && command -v batcat >/dev/null 2>&1; then
  alias bat='batcat'
fi

_dotfiles_confirm_upgrade() {
  local answer

  printf 'Proceed with package upgrades and autoremove? [y/N] '
  read -r answer

  case "$answer" in
  [Yy] | [Yy][Ee][Ss]) return 0 ;;
  *)
    echo 'Aborted.'
    return 1
    ;;
  esac
}

_dotfiles_upgrade() {
  case "$(uname -s)" in
  Linux)
    if command -v apt >/dev/null 2>&1; then
      sudo apt update || return
      apt list --upgradable || return
      _dotfiles_confirm_upgrade || return
      sudo apt upgrade && sudo apt autoremove
    elif command -v brew >/dev/null 2>&1; then
      brew update || return
      brew outdated || return
      _dotfiles_confirm_upgrade || return
      brew upgrade && brew autoremove
    else
      echo 'upgrade: expected apt or brew on Linux' >&2
      return 1
    fi
    ;;
  Darwin)
    if command -v brew >/dev/null 2>&1; then
      brew update || return
      brew outdated || return
      _dotfiles_confirm_upgrade || return
      brew upgrade && brew autoremove
    else
      echo 'upgrade: Homebrew is required on macOS' >&2
      return 1
    fi
    ;;
  *)
    echo "upgrade: unsupported OS: $(uname -s)" >&2
    return 1
    ;;
  esac
}

gc() {
  if [[ $# -eq 0 ]]; then
    echo 'usage: gc <message>' >&2
    return 1
  fi

  git commit -v -m "$*"
}

tt() {
  if [[ $# -eq 0 ]]; then
    echo 'usage: tt <session-name>' >&2
    return 1
  fi

  tmux new-session -s "$1" -n "$1"
}

# Add common user-local bin directories first when they exist.
[[ -d "$HOME/.local/bin" ]] && export PATH="$HOME/.local/bin:$PATH"
[[ -d "$HOME/bin" ]] && export PATH="$HOME/bin:$PATH"

# Tool initialization.
export NVM_DIR="$HOME/.nvm"
[[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh"
[[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"

# use nvim if available
if [ -x "$(command -v nvim)" ]; then
    alias vim='nvim'
fi

command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

#------------------------------------------------------
# Functions
#------------------------------------------------------

# Find out what's running on a given port
whatsonport() {
    lsof -i tcp:$1
}

