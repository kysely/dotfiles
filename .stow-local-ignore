# GNU Stow ignore list (built-in defaults)
# Comments and blank lines are allowed.

RCS
.+,v

CVS
\.\#.+       # CVS conflict files / emacs lock files
\.cvsignore

\.svn
_darcs
\.hg

\.git
\.gitignore
\.gitmodules

.+~          # emacs backup files
\#.*\#       # emacs autosave files

^/README.*
^/LICENSE.*
^/COPYING

# Repo/bootstrap shell files and package manifests that should not be symlinked into $HOME
^/install$
^/install-.*
^/.*\.sh$
^/packages\.txt
^/\.stow-local-ignore
^/blink$
