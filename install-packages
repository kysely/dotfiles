#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PACKAGE_FILE="$ROOT_DIR/packages.txt"

has() {
  command -v "$1" >/dev/null 2>&1
}

require_package_file() {
  if [[ ! -f "$PACKAGE_FILE" ]]; then
    echo "Missing $PACKAGE_FILE" >&2
    exit 1
  fi
}

require_homebrew() {
  if has brew; then
    return
  fi

  echo "Homebrew is required but was not found." >&2
  echo "Please install it manually from https://brew.sh/ and re-run this script." >&2
  exit 1
}

install_with_brew() {
  require_package_file
  require_homebrew

  local taps=()
  local formulae=()
  local casks=()
  local line name token brew_pkg apt_pkg package_type tap

  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue

    read -ra parts <<<"$line"
    name="${parts[0]}"
    brew_pkg="$name"
    apt_pkg="$name"
    package_type="formula"
    tap=""

    for token in "${parts[@]:1}"; do
      case "$token" in
      brew=*) brew_pkg="${token#brew=}" ;;
      apt=*) apt_pkg="${token#apt=}" ;;
      type=*) package_type="${token#type=}" ;;
      tap=*) tap="${token#tap=}" ;;
      *)
        echo "Unknown package option '$token' in: $line" >&2
        exit 1
        ;;
      esac
    done

    [[ -n "$tap" ]] && taps+=("$tap")
    [[ "$brew_pkg" == "-" ]] && continue

    case "$package_type" in
    formula) formulae+=("$brew_pkg") ;;
    cask) casks+=("$brew_pkg") ;;
    *)
      echo "Unknown package type '$package_type' in: $line" >&2
      exit 1
      ;;
    esac
  done <"$PACKAGE_FILE"

  for tap in "${taps[@]}"; do
    brew tap "$tap"
  done

  if [[ ${#formulae[@]} -gt 0 ]]; then
    brew install "${formulae[@]}"
  fi

  if [[ ${#casks[@]} -gt 0 ]]; then
    brew install --cask "${casks[@]}"
  fi
}

install_with_apt() {
  require_package_file

  local packages=()
  local line name token brew_pkg apt_pkg package_type

  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue

    read -ra parts <<<"$line"
    name="${parts[0]}"
    brew_pkg="$name"
    apt_pkg="$name"
    package_type="formula"

    for token in "${parts[@]:1}"; do
      case "$token" in
      brew=*) brew_pkg="${token#brew=}" ;;
      apt=*) apt_pkg="${token#apt=}" ;;
      type=*) package_type="${token#type=}" ;;
      tap=*) ;;
      *)
        echo "Unknown package option '$token' in: $line" >&2
        exit 1
        ;;
      esac
    done

    [[ "$apt_pkg" == "-" ]] && continue
    packages+=("$apt_pkg")
  done <"$PACKAGE_FILE"

  sudo apt-get update

  if [[ ${#packages[@]} -gt 0 ]]; then
    sudo apt-get install -y "${packages[@]}"
  else
    echo "No apt packages listed in $PACKAGE_FILE"
  fi
}

require_curl() {
  if ! has curl; then
    echo "curl is required but was not found." >&2
    exit 1
  fi
}

install_difftastic() {
  if has difft; then
    return
  fi

  if [[ "$(uname -s)" != "Linux" ]]; then
    return
  fi

  require_curl

  local target url tmpdir archive difft_bin

  case "$(uname -m)" in
  x86_64 | amd64) target="x86_64-unknown-linux-gnu" ;;
  aarch64 | arm64) target="aarch64-unknown-linux-gnu" ;;
  *)
    echo "Unsupported architecture for difftastic: $(uname -m)" >&2
    echo "Install manually from https://github.com/Wilfred/difftastic/releases" >&2
    exit 1
    ;;
  esac

  url="https://github.com/Wilfred/difftastic/releases/latest/download/difft-$target.tar.gz"
  tmpdir="$(mktemp -d)"
  archive="$tmpdir/difftastic.tar.gz"

  (
    trap 'rm -rf "$tmpdir"' EXIT

    curl -fsSL "$url" -o "$archive"
    tar -xzf "$archive" -C "$tmpdir"

    difft_bin="$(find "$tmpdir" -type f -name difft -print -quit)"
    if [[ -z "$difft_bin" ]]; then
      echo "Downloaded difftastic archive did not contain a difft binary." >&2
      exit 1
    fi

    sudo install -d -m 0755 /usr/local/bin
    sudo install -m 0755 "$difft_bin" /usr/local/bin/difft
  )
}

install_lazygit() {
  if has lazygit; then
    return
  fi

  if [[ "$(uname -s)" != "Linux" ]]; then
    return
  fi

  require_curl

  local arch url tmpdir archive lazygit_bin

  case "$(uname -m)" in
  x86_64 | amd64) arch="x86_64" ;;
  aarch64 | arm64) arch="arm64" ;;
  *)
    echo "Unsupported architecture for lazygit: $(uname -m)" >&2
    echo "Install manually from https://github.com/jesseduffield/lazygit/releases" >&2
    exit 1
    ;;
  esac

  url="$(curl -fsSL https://api.github.com/repos/jesseduffield/lazygit/releases/latest \
    | grep -E '"browser_download_url": ".*linux_'"$arch"'\.tar\.gz"' \
    | head -n 1 \
    | cut -d '"' -f 4)"

  if [[ -z "$url" ]]; then
    echo "Could not find a lazygit release asset for linux $arch." >&2
    exit 1
  fi

  tmpdir="$(mktemp -d)"
  archive="$tmpdir/lazygit.tar.gz"

  (
    trap 'rm -rf "$tmpdir"' EXIT

    curl -fsSL "$url" -o "$archive"
    tar -xzf "$archive" -C "$tmpdir"

    lazygit_bin="$(find "$tmpdir" -type f -name lazygit -print -quit)"
    if [[ -z "$lazygit_bin" ]]; then
      echo "Downloaded lazygit archive did not contain a lazygit binary." >&2
      exit 1
    fi

    sudo install -d -m 0755 /usr/local/bin
    sudo install -m 0755 "$lazygit_bin" /usr/local/bin/lazygit
  )
}

install_lazycaddy() {
  if has lazycaddy; then
    return
  fi

  require_curl
  curl -fsSL https://raw.githubusercontent.com/kysely/lazycaddy/main/install.sh | sh
}

install_starship() {
  if has starship; then
    return
  fi

  require_curl
  curl -sS https://starship.rs/install.sh | sh -s -- -y
}

install_linux_command_shims() {
  if [[ "$(uname -s)" != "Linux" ]]; then
    return
  fi

  # Debian/Ubuntu rename a couple of upstream commands to avoid package/name
  # conflicts. Provide the upstream names so tools and muscle memory work.
  sudo install -d -m 0755 /usr/local/bin

  if ! has bat && has batcat; then
    sudo ln -sfn "$(command -v batcat)" /usr/local/bin/bat
  fi

  if ! has fd && has fdfind; then
    sudo ln -sfn "$(command -v fdfind)" /usr/local/bin/fd
  fi
}

install_nvm() {
  export NVM_DIR="$HOME/.nvm"

  if [[ ! -s "$NVM_DIR/nvm.sh" ]]; then
    require_curl

    if [[ -d "$NVM_DIR" ]]; then
      local backup_dir
      backup_dir="$NVM_DIR.backup.$(date +%Y%m%d%H%M%S)"
      echo "$NVM_DIR exists but nvm.sh is missing; moving it to $backup_dir"
      mv "$NVM_DIR" "$backup_dir"
    fi

    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.4/install.sh | bash
  fi

  if [[ -s "$NVM_DIR/nvm.sh" ]]; then
    # shellcheck disable=SC1091
    source "$NVM_DIR/nvm.sh"
    nvm install --lts
    nvm alias default 'lts/*'
    nvm use default
  else
    echo "nvm installation failed: $NVM_DIR/nvm.sh was not found." >&2
    exit 1
  fi
}

fix_npm_cache_permissions() {
  local npm_cache

  npm_cache="$(npm config get cache)"

  if [[ "$EUID" -ne 0 && -d "$npm_cache" && ( "$npm_cache" == "$HOME"/* || "$npm_cache" == "$HOME" ) ]]; then
    sudo chown -R "$(id -u):$(id -g)" "$npm_cache"
  fi
}

npm_global_install() {
  local npm_bin npm_prefix

  npm_bin="$(command -v npm)"
  npm_prefix="$(npm config get prefix)"

  if [[ "$EUID" -eq 0 || "$npm_prefix" == "$HOME"/* || "$npm_prefix" == "$HOME" || "$npm_prefix" == "$NVM_DIR"/* ]]; then
    "$npm_bin" install -g "$@"
  else
    sudo "$npm_bin" install -g "$@"
  fi
}

install_npm_globals() {
  export NVM_DIR="$HOME/.nvm"

  if [[ -s "$NVM_DIR/nvm.sh" ]]; then
    # shellcheck disable=SC1091
    source "$NVM_DIR/nvm.sh"
    nvm use default >/dev/null
  fi

  if ! has npm; then
    echo "npm is required to install global npm packages but was not found." >&2
    exit 1
  fi

  fix_npm_cache_permissions

  npm_global_install @earendil-works/pi-coding-agent
  npm_global_install hunkdiff
}

main() {
  case "$(uname -s)" in
  Darwin)
    install_with_brew
    ;;
  Linux)
    if has apt-get; then
      install_with_apt
    elif has brew; then
      echo "apt-get not found; using Homebrew on Linux."
      install_with_brew
    else
      echo "Unsupported Linux system: expected apt-get or brew." >&2
      exit 1
    fi
    ;;
  *)
    echo "Unsupported OS: $(uname -s)" >&2
    exit 1
    ;;
  esac

  install_linux_command_shims
  install_difftastic
  install_lazygit
  install_lazycaddy
  install_starship
  install_nvm
  install_npm_globals
}

main "$@"
